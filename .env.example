# MYMINICLOUD - THÔNG TIN KẾT NỐI VÀ ĐĂNG NHẬP THEO SERVER
# File mẫu: chạy python scripts/init-env.py để tạo .env local ngẫu nhiên.
# Đăng nhập bằng GIÁ TRỊ sau dấu =, không nhập tên biến.

# ============================================================
# 1. WEB / NGINX GATEWAY - http://localhost/
# Portal, Blog và API không có tài khoản đăng nhập riêng.
# ============================================================
PUBLIC_URL=http://localhost

# ============================================================
# 2. SQL SERVER - KẾT NỐI BẰNG SSMS
# Server: 127.0.0.1,1433 | SQL Server Authentication
# Username: DB_USER | Password: DB_PASSWORD | Database: DB_NAME
# Chọn Trust server certificate cho môi trường demo local.
# ============================================================
DB_USER=cloud_app
DB_PASSWORD=REPLACE_WITH_SEPARATE_APP_PASSWORD
DB_NAME=studentdb
DB_TRUST_CERTIFICATE=yes
# Tài khoản sa dùng bootstrap/quản trị SQL, không dùng cho Flask runtime.
# Username: sa | Password: MSSQL_SA_PASSWORD
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD

# ============================================================
# 3. KEYCLOAK ADMIN - http://localhost/auth/admin/
# Username: KEYCLOAK_ADMIN | Password: KEYCLOAK_ADMIN_PASSWORD
# Realm chung cho hai thành viên 521H0092 và 523H0065.
# ============================================================
OIDC_REALM=521H0092-523H0065
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# ============================================================
# 4. TÀI KHOẢN DEMO - http://localhost/#auth
# Portal > Xác thực > Đăng nhập Keycloak SSO. Username: sv01 hoặc sv02
# Hai user demo dùng Password: DEMO_USER_PASSWORD
# ============================================================
DEMO_USER_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD

# ============================================================
# 5. MINIO CONSOLE - http://localhost:9001/
# Username: MINIO_ROOT_USER | Password: MINIO_ROOT_PASSWORD
# Port9000 là S3 API; dùng port9001 để đăng nhập Console.
# ============================================================
MINIO_ROOT_USER=cloudadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_STORAGE_PASSWORD

# ============================================================
# 6. GRAFANA - http://localhost:3000/d/mycloud-system
# Username: GRAFANA_ADMIN_USER | Password: GRAFANA_ADMIN_PASSWORD
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_GRAFANA_PASSWORD

# ============================================================
# 7. DỊCH VỤ KHÔNG CÓ TÀI KHOẢN ĐĂNG NHẬP RIÊNG
# Prometheus: http://localhost:9090/targets
# Bind9 DNS: 127.0.0.1:1053 UDP/TCP, kiểm tra bằng dig, không có Web UI.
# Node Exporter / Blackbox: chỉ dùng mạng nội bộ; xem qua Prometheus/Grafana.
# ============================================================
